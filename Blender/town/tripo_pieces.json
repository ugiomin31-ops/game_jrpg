{
 "version": 1,
 "doc": "Tripo town pieces that replace procedural builds in guild.py. Paths are repo-relative (or absolute). A piece whose fbx or texture file is missing is skipped and guild.py falls back to the procedural build named in 'replaces'. Environment GUILD_NO_TRIPO=1 forces the fallback for every piece. Coordinates are Blender metres, Z up. Piece meshes are already scaled, ground-level and pivoted at their staging origin (ArtSource/town/<id>/staging/placement.json), so an instance is just object location + rotation_z_deg.",
 "fields": {
  "id": "short name, also the staging folder",
  "fbx": "staged FBX (single mesh, already scaled)",
  "material": "material name in the FBX; Unity needs Art/Town/town_tex/<material>.png (guild.py copies the texture there)",
  "texture": "base-colour PNG",
  "tris": "expected triangle count (checked after import)",
  "bounds_local": "mesh bounds around the instance origin {min, max}",
  "replaces": "tokens of procedural builds that are skipped when the piece is installed (hq, fountain, clinic, market, workshop, notice_board = the plaza board at (-9.6,-1.5) (the HQ Quest_Board stays procedural), banner = all three street pennants, street_lamp = the three plaza street lamps (their LightAnchor_street_* keep x/y, z from params.lamp_anchor_z; festoon strings and the east pole follow params.festoon_*), gate_arch = pillars/arch/ring/disc, gate_rune = floor rune circle, guard_booths ...)",
  "instances": "[{object, location, rotation_z_deg, scale?}] object name in town.fbx and its placement; scale must be a single number (uniform: the Tripo geometry is never stretched)",
  "colliders": "[{name, min, max, instance}] boxes in the instance's local space; exported as Col_<name>. Procedural colliders of a replaced build are not made",
  "body_local": "optional [x0, y0, x1, y1] footprint in the instance's local space (HQ footprint / paving edges; clinic, market and workshop use it for their Col_ boxes)",
  "spots": "{Spot_name: [x, y, z]} marker moves that only apply while this piece is installed (yaw is kept)",
  "params": "free build parameters read by guild.py while this piece is installed"
 },
